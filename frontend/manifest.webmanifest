{
  "name": "TransitPulse — Real-Time Bus Tracker",
  "short_name": "TransitPulse",
  "description": "Crowdsourced bus arrivals and live ETA tracking for daily commuters.",
  "start_url": "/index.html",
  "display": "standalone",
  "background_color": "#0e141b",
